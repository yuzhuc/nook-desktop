<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:navigation="clr-namespace:nook_desktop.Core.Navigation"
             x:Class="nook_desktop.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <navigation:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://nook/Themes/Palette.axaml" />
                <ResourceInclude Source="avares://nook/Themes/Icons.axaml" />
                <ResourceInclude Source="avares://nook/Themes/ButtonTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://nook/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
