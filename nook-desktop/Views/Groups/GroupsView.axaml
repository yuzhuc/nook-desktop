<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:nook_desktop.ViewModels.Groups"
             mc:Ignorable="d"
             x:Class="nook_desktop.Views.Groups.GroupsView"
             x:DataType="vm:GroupsViewModel"
             d:DesignWidth="1180"
             d:DesignHeight="700">
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- 顶部：只留标题。搜索框已移到窗口标题栏中栏，成为全局控件 -->
        <StackPanel Grid.Row="0"
                    Margin="20,18,20,12"
                    Spacing="2"
                    VerticalAlignment="Center">
            <TextBlock Classes="h1" Text="群组" />
            <TextBlock Classes="caption" Text="{Binding StatusText}" />
        </StackPanel>

        <!-- 分类标签 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="20,0,20,12"
                    Spacing="4">
            <ToggleButton Classes="tab"
                          Content="全部"
                          IsChecked="{Binding IsAllSelected, Mode=TwoWay}" />
            <ToggleButton Classes="tab"
                          Content="我的群组"
                          IsChecked="{Binding IsJoinedSelected, Mode=TwoWay}" />
            <ToggleButton Classes="tab"
                          Content="最近访问"
                          IsChecked="{Binding IsRecentSelected, Mode=TwoWay}" />
        </StackPanel>

        <!-- 群组卡片网格 -->
        <!--
            左右内边距从 20 收到 12：窗口本身已经有 8 的外框边距了，
            再叠 20 会把可用宽度压到刚好放不下 4 张卡片（卡片占位 252+14=266，
            4 张需 1064，而 1180 宽的窗口只剩 1060），导致第 4 张换行。
        -->
        <ScrollViewer Grid.Row="2" Padding="12,0,12,20">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:GroupCardViewModel">
                        <Button Width="252"
                                Margin="0,0,14,14"
                                Padding="0"
                                Classes="groupcard"
                                Command="{Binding $parent[UserControl].((vm:GroupsViewModel)DataContext).JoinGroupCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Vertical">
                                <!-- 封面：用群组主色占位，后续替换为群头像 -->
                                <Border Height="104"
                                        CornerRadius="11,11,0,0"
                                        Background="{Binding AccentBrush}">
                                    <Path Classes="icon"
                                          Data="{StaticResource IconHash}"
                                          Width="30"
                                          Height="30"
                                          Stroke="#FFFFFF"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Margin="14,12,14,14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Ellipse Grid.Column="1"
                                                 Width="7"
                                                 Height="7"
                                                 Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource SuccessBrush}" />
                                    </Grid>

                                    <TextBlock Classes="caption"
                                               Margin="0,4,0,0"
                                               Text="{Binding Description}"
                                               TextTrimming="CharacterEllipsis" />

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,10,0,0"
                                                Spacing="10">
                                        <TextBlock Classes="caption" Text="{Binding OnlineText}" />
                                        <TextBlock Classes="caption" Text="{Binding ChannelText}" />
                                    </StackPanel>

                                    <Border Margin="0,12,0,0"
                                            Padding="10,7"
                                            CornerRadius="6"
                                            Background="{DynamicResource SurfaceOverlayBrush}">
                                        <TextBlock Text="{Binding ActionText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
